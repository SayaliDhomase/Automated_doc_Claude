# Copy to .env and fill in real values. Never commit .env.
# All integrations are optional — the pipeline falls back to local-file / direct-input
# sources when an integration's variables are absent. See mcp/README.md for details.

# --- Jira (documented integration point; no MCP server wired yet) ---
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# --- Confluence (documented integration point; no MCP server wired yet) ---
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=

# --- GitHub (PR preparation target) ---
# Prefer `gh auth login` over a raw token where possible.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo

# --- Documentation Sync tool config ---
# DOC_SYNC_TEMPLATE_PATH=./examples/master-template.md
# DOC_SYNC_SOURCE_REPO_PATH=./examples/sample-source-repo
# DOC_SYNC_OUTPUT_PATH=./out/technical-manifest.md
